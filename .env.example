# Canonical production origin used for metadata, sitemap, robots and JSON-LD.
# Set this to the final custom domain when it is connected. The app falls back
# to https://faizan-portfolio-site.vercel.app and rejects localhost values.
NEXT_PUBLIC_SITE_URL=https://faizan-portfolio-site.vercel.app

# Optional Bing Webmaster Tools verification token.
# BING_SITE_VERIFICATION=your-msvalidate-token
